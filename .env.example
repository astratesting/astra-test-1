# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astra

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet encryption key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
